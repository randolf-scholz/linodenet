#!/usr/bin/env just --justfile
export PYTORCH_JIT := "0"

[default]
[doc("Build the Sphinx HTML documentation (the current default).")]
make *sphinx_args:
    just --justfile {{ justfile() }} sphinx {{ sphinx_args }}

[doc("Show documentation commands.")]
help:
    @just --justfile {{ justfile() }} --list docs

[doc("Remove Sphinx output and generated API source files.")]
sphinx-clean:
    rm -rf build/sphinx sphinx/_autosummary sphinx/autoapi sphinx/apidoc

#[doc("Remove MkDocs output.")]
#mkdocs-clean:
#    rm -rf build/mkdocs

[doc("Remove ProperDocs output.")]
properdocs-clean:
    rm -rf build/properdocs

[doc("Remove Zensical output and generated API Markdown.")]
zensical-clean:
    rm -rf build/zensical zensical/reference

[doc("Remove all generated documentation output.")]
clean: sphinx-clean properdocs-clean zensical-clean

#[doc("Build the MkDocs proof-of-concept site with strict validation.")]
#mkdocs *mkdocs_args: mkdocs-clean
#    uv run mkdocs build --strict --config-file mkdocs/mkdocs.yaml {{ mkdocs_args }}

[doc("Build the ProperDocs proof-of-concept site with strict validation.")]
properdocs *properdocs_args: properdocs-clean
    uv run properdocs build --strict --config-file properdocs/properdocs.yaml {{ properdocs_args }}

[doc("Build the Zensical proof-of-concept site with generated API Markdown.")]
zensical *zensical_args: zensical-clean
    uv run python zensical/scripts/generate_reference.py
    uv run zensical build --clean --strict --config-file zensical.toml {{ zensical_args }}
    # Zensical does not copy a symlink whose target is outside its docs directory.
    cp -RL zensical/_static build/zensical/

[doc("Rebuild the Sphinx API docs and HTML output.")]
sphinx *sphinx_args: sphinx-clean
    uv run sphinx-build -M html sphinx build/sphinx {{ sphinx_args }}
    # Sphinx Immaterial omits user static files when bundling theme assets.
    cp -RL _static/* build/sphinx/html/_static/
