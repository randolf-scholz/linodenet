   "source": [
    "import time\n",
    "\n",
    "import torch\n",
    "\n",
    "torch.cuda.init()\n",
    "device = \"cuda\"\n",
    "\n",
    "def enqueue_heavy_work():\n",
    "    # Big matmul to keep GPU busy\n",
    "    a = torch.randn(8192, 8192, device=device)\n",
    "    b = torch.randn(8192, 8192, device=device)\n",
    "    c = a @ b\n",
    "    return c\n",
    "\n",
    "def time_call(fn, iters=20):\n",
    "    # Warmup\n",
    "    for _ in range(5):\n",
    "        fn()\n",
    "    torch.cuda.synchronize()\n",
    "\n",
    "    t0 = time.perf_counter()\n",
    "    for _ in range(iters):\n",
    "        fn()\n",
    "    t1 = time.perf_counter()\n",
    "    return (t1 - t0) / iters\n",
    "\n",
    "# Case A: your pattern (should NOT sync)\n",
    "x = torch.ones(1, device=device)\n",
    "\n",
    "def baseline():\n",
    "\t_ = enqueue_heavy_work()\n",
    "\treturn x\n",
    "\n",
    "def no_sync_branch():\n",
    "    _ = enqueue_heavy_work()\n",
    "    y = None\n",
    "    if y is None:\n",
    "        return x\n",
    "    return x + y\n",
    "\n",
    "# Case B: data-dependent control flow (WILL sync)\n",
    "def sync_branch():\n",
    "    t = enqueue_heavy_work()\n",
    "    # This forces a Python bool decision based on a CUDA result\n",
    "    if (t[0, 0] != 0).item():\n",
    "        return x\n",
    "    return x\n",
    "\n",
    "print(\"baseline       avg seconds:\", time_call(enqueue_heavy_work))\n",
    "print(\"no_sync_branch avg seconds:\", time_call(no_sync_branch))\n",
    "print(\"sync_branch    avg seconds:\", time_call(sync_branch))"
   ]
  }
